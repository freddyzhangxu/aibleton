<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Build the Windows desktop target on this Mac (no Windows box needed). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AssemblyName>AIbletonBar</AssemblyName>
    <RootNamespace>AIbletonBar</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Product>AIbletonBar</Product>
    <Description>Floating sidebar for the AIbleton Live extension</Description>
    <!-- Version is stamped by build.sh from ../../AIbleton/package.json. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand logo (caption strip + collapsed bar) lives with the macOS assets. -->
    <EmbeddedResource Include="..\Resources\AIbleton.png">
      <Link>Resources\AIbleton.png</Link>
      <LogicalName>AIbletonBar.Resources.AIbleton.png</LogicalName>
    </EmbeddedResource>
    <!-- Generated by build.sh from ../Resources/AppIcon.icns. -->
    <EmbeddedResource Include="Resources\AppIcon.ico">
      <LogicalName>AIbletonBar.Resources.AppIcon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
